{
	"schema_version": "1.0",
	"scenario_meta": {
		"id": "icu_scenario_septic_shock_v1",
		"title": "ΜΕΘ: Διαχείριση Σηπτικού Shock",
		"description": "Σενάριο διαχείρισης υπότασης και πυρετού με ένδειξη σηπτικού shock, απαιτεί άμεση παρέμβαση και υποχρεωτική ψηφιακή τεκμηρίωση.",
		"estimated_duration_minutes": 8.0,
		"difficulty": "Intermediate",
		"learning_goals": [
			"Αναγνώριση κλινικού συναγερμού (ταχυκαρδία / υπόταση)",
			"Αλληλεπίδραση με hotspots (Αναπνευστήρας, Μόνιτορ)",
			"Χρήση Documentation Gates στο e-Health module",
			"Τήρηση πρωτοκόλλου κλιμάκωσης"
		]
	},
	"initial_state": {
		"time_elapsed": 0.0,
		"current_score": 100.0,
		"flags": {
			"assessment_complete": false,
			"oxygen_support_given": false,
			"documentation_1_complete": false,
			"escalation_complete": false,
			"documentation_2_complete": false
		},
		"vitals": {
			"hr": 128.0,
			"spo2": 94.0,
			"rr": 26.0,
			"bp": "82/50",
			"temp": 39.4
		},
		"ui": {
			"active_hotspots": [
				"hs_monitor",
				"hs_patient",
				"hs_ventilator",
				"hs_ehr",
				"hs_call"
			],
			"monitor_alert": true
		}
	},
	"hotspots": [
		{ "id": "hs_monitor", "label": "Μόνιτορ Ζωτικών (Monitor)" },
		{ "id": "hs_patient", "label": "Ασθενής/Κλίνη (Patient)" },
		{ "id": "hs_ventilator", "label": "Αναπνευστήρας (Ventilator)" },
		{ "id": "hs_ehr", "label": "Τερματικό EHR (e-Health)" },
		{ "id": "hs_call", "label": "Κουμπί Κλήσης (Call Button)" }
	],
	"ehr_config": {
		"forms": {
			"assessment_form": {
				"title": "Κλινική Αξιολόγηση",
				"fields": ["observation", "skin_color", "consciousness"]
			},
			"intervention_form": {
				"title": "Παρεμβάσεις / Ρυθμίσεις",
				"fields": ["device", "fiO2_setting", "flow_rate"]
			},
			"communication_log": {
				"title": "Ημερολόγιο Επικοινωνίας",
				"fields": ["recipient", "reason", "outcome"]
			}
		}
	},
	"rules": {
		"global_rules": [
			{
				"id": "rule_tachycardia_alarm",
				"condition": {
					"target_vital": "hr",
					"greater_than": 130.0
				},
				"effects": [
					{ "type": "ui_visual", "target": "hs_monitor", "state": "blinking_red" },
					{ "type": "ui_toast", "style": "danger", "message": "ΣΥΝΑΓΕΡΜΟΣ: Ταχυκαρδία HR > 130 (πιθανό σηπτικό shock)" }
				]
			}
		]
	},
	"nodes": [
		{
			"id": "n1_start",
			"type": "message",
			"text": "Βρίσκεστε στη ΜΕΘ. Η ασθενής στην κλίνη 2 εμφανίζει πυρετό και υπόταση. Το μόνιτορ δείχνει ΑΠ 82/50 και HR 128.",
			"next_node_id": "n2_initial_decision"
		},
		{
			"id": "n2_initial_decision",
			"type": "decision",
			"text": "Ποια είναι η πρώτη σου ενέργεια;",
			"options": [
				{
					"id": "opt_assess",
					"label": "Άμεση Αξιολόγηση Ασθενούς",
					"target_hotspot": "hs_patient",
					"effects": {
						"score_delta": 10.0,
						"flag_to_toggle": "assessment_complete",
						"toast": "Παρατηρείς ωχρό δέρμα, παρατεταμένο capillary refill και ζέστη στην αφή."
					},
					"next_node_id": "n3_intervention"
				},
				{
					"id": "opt_check_monitor",
					"label": "Έλεγχος Ιστορικού στο Μόνιτορ",
					"target_hotspot": "hs_monitor",
					"effects": {
						"score_delta": 5.0,
						"toast": "Βλέπεις σταδιακή πτώση της αρτηριακής πίεσης τις τελευταίες ώρες."
					},
					"next_node_id": "n3_intervention"
				}
			],
			"timeout": {
				"seconds": 30.0,
				"on_timeout_effects": {
					"vitals_update": { "hr": 138.0, "temp": 39.8 },
					"score_delta": -10.0,
					"toast": "⚠️ Καθυστέρηση! Η κατάσταση επιδεινώνεται, πιθανό σηπτικό shock."
				},
				"next_node_id": "n3_intervention"
			}
		},
		{
			"id": "n3_intervention",
			"type": "decision",
			"text": "Η ασθενής χρειάζεται άμεση υποστήριξη οξυγόνωσης και παρακολούθηση.",
			"options": [
				{
					"id": "opt_increase_o2",
					"label": "Χορήγηση Συμπληρωματικού Οξυγόνου",
					"target_hotspot": "hs_ventilator",
					"effects": {
						"flag_to_toggle": "oxygen_support_given",
						"vitals_update": { "spo2": 98.0, "hr": 118.0 },
						"score_delta": 20.0,
						"toast": "✅ Η χορήγηση οξυγόνου βοηθά. Η κατάσταση σταθεροποιείται."
					},
					"next_node_id": "n4_gate_documentation_1"
				},
				{
					"id": "opt_do_nothing",
					"label": "Καμία αλλαγή - Αναμονή",
					"target_hotspot": "hs_patient",
					"effects": {
						"vitals_update": { "hr": 142.0, "temp": 40.1 },
						"score_delta": -20.0,
						"toast": "⛔ Κρίσιμη επιδείνωση. Κίνδυνος σηπτικού shock."
					},
					"next_node_id": "n4_gate_documentation_1"
				}
			]
		},
		{
			"id": "n4_gate_documentation_1",
			"type": "gate",
			"text": "🛑 GATE: Τεκμηρίωση Αξιολόγησης & Παρέμβασης.",
			"description": "Το σύστημα μπλοκάρει τη συνέχεια μέχρι να συμπληρωθούν τα πεδία στο EHR.",
			"gate_requirements": {
				"target_hotspot": "hs_ehr",
				"required_forms": [
					{ "form_id": "assessment_form", "fields": ["observation"] },
					{ "form_id": "intervention_form", "fields": ["device"] }
				]
			},
			"feedback_blocked": "⚠️ Πρέπει να συμπληρώσεις το EHR για να προχωρήσεις.",
			"feedback_success": "✅ Η τεκμηρίωση αποθηκεύτηκε.",
			"effects_on_pass": {
				"flag_to_toggle": "documentation_1_complete",
				"score_delta": 10.0
			},
			"next_node_id": "n5_reassessment"
		},
		{
			"id": "n5_reassessment",
			"type": "message",
			"text": "10 λεπτά αργότερα... Η αρτηριακή πίεση παραμένει χαμηλή αλλά σταθερή.",
			"next_node_id": "n6_escalation_decision"
		},
		{
			"id": "n6_escalation_decision",
			"type": "decision",
			"text": "Χρειάζεται κλιμάκωση φροντίδας;",
			"options": [
				{
					"id": "opt_call_doc",
					"label": "Κλήση Εντατικολόγου (Κλιμάκωση)",
					"target_hotspot": "hs_call",
					"effects": {
						"flag_to_toggle": "escalation_complete",
						"score_delta": 10.0,
						"toast": "Ειδοποιήθηκε ο εφημερεύων εντατικολόγος."
					},
					"next_node_id": "n7_gate_documentation_2"
				},
				{
					"id": "opt_wait",
					"label": "Όχι, συνεχίζω παρακολούθηση",
					"target_hotspot": "hs_monitor",
					"effects": {
						"score_delta": 0.0,
						"toast": "Συνεχίζεις την παρακολούθηση."
					},
					"next_node_id": "n8_end_scenario"
				}
			]
		},
		{
			"id": "n7_gate_documentation_2",
			"type": "gate",
			"text": "🛑 GATE: Καταγραφή Επικοινωνίας.",
			"description": "Κατάγραψε την κλήση στο Communication Log.",
			"gate_requirements": {
				"target_hotspot": "hs_ehr",
				"required_forms": [
					{ "form_id": "communication_log", "fields": ["recipient", "outcome"] }
				]
			},
			"feedback_blocked": "⚠️ Εκκρεμεί η καταγραφή της κλήσης στο EHR.",
			"feedback_success": "✅ Η τεκμηρίωση αποθηκεύτηκε.",
			"effects_on_pass": {
				"flag_to_toggle": "documentation_2_complete",
				"score_delta": 5.0
			},
			"next_node_id": "n8_end_scenario"
		},
		{
			"id": "n8_end_scenario",
			"type": "end",
			"text": "Το σενάριο ολοκληρώθηκε.",
			"debrief_config": {
				"show_score": true,
				"show_decision_path": true,
				"highlight_missed_docs": true,
				"export_log": true
			}
		}
	],
	"logging": {
		"enabled": true,
		"log_events": ["NODE_ENTER", "HOTSPOT_INTERACTION", "OPTION_SELECTED", "EHR_SUBMIT", "VITALS_CHANGE"],
		"export_format": "JSON"
	}
}
